# Neon Serverless Postgres Connection String
# Get this from your Neon Console (https://console.neon.tech) -> Connection Details -> URI
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Configuration
# Generate a secret: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-replace-this"
NEXTAUTH_URL="http://localhost:3000"

# AI Agent Configuration
GOOGLE_API_KEY=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
